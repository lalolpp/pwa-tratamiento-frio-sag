{
  "name": "pwa-tratamiento-frio-sag",
  "version": "1.0.0",
  "description": "PWA Evaluador de Tratamientos de Frío SAG",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist:win": "electron-builder --win portable",
    "apk:android": "node scripts/build-apk.mjs"
  },
  "build": {
    "appId": "cl.sag.tratamiento.frio",
    "productName": "Tratamiento Frio SAG",
    "asar": true,
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/tratamiento-frio.ico"
    },
    "portable": {
      "artifactName": "TratamientoFrioSAG.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "chart.js": "^4.4.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^6.0.0"
  }
}
